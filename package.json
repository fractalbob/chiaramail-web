{
  "name": "chiaramail",
  "private": true,
  "version": "7.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "emulators": "firebase emulators:start --only auth,firestore,storage --project demo-chiaramail",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-chiaramail \"node --test tests/rules.test.js\"",
    "deploy": "npm run build && firebase deploy --only hosting:mail,firestore:rules,firestore:indexes,storage",
    "dev:mock": "vite --mode mock",
    "build:mock": "vite build --mode mock",
    "test:unit": "node --test tests/mime.test.js",
    "test:e2e": "npm run build:mock && echo \"Run: npx vite preview, then BASE=http://localhost:4173 node tests/e2e-mail.mjs shots\"",
    "build:desktop": "vite build --mode desktop --outDir desktop/renderer --emptyOutDir"
  },
  "dependencies": {
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "dompurify": "^3.4.16",
    "firebase": "^12.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-tools": "^15.32.1",
    "globals": "^17.13.0",
    "playwright": "^1.63.0",
    "postal-mime": "^4.0.5",
    "vite": "^8.3.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  }
}
