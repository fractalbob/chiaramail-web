rules_version = '2';

// ChiaraMail — the web successor of ChiaraMail 5.1's content server, which
// keeps the content of ECS (Envelope-Content Splitting) messages.
// A message's text lives here, not in the email. Only the sender and the
// listed recipients can read it (the old server's isRecipient() check),
// and only the sender can change or withdraw it (UPDATE CONTENT).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    // A reader's address only counts once the sign-in provider has verified it
    // (email-link and Google sign-in both do).
    function verified() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isSender(data) {
      return signedIn() && data.senderUid == request.auth.uid;
    }
    function isRecipient(data) {
      return verified() && myEmail() in data.recipients;
    }
    function msg(id) {
      return get(/databases/$(database)/documents/messages/$(id)).data;
    }
    // The message as it will be once the current batch commits — editions
    // are written in the same batch as the message they belong to.
    function msgAfter(id) {
      return getAfter(/databases/$(database)/documents/messages/$(id)).data;
    }

    // ---- Attachment allowance -------------------------------------------------
    // Each sender may keep up to 1 GB of ECS attachments stored at once.
    // usage/{uid}.bytes is their running total: a new ECS message with files
    // must raise it by exactly the files' declared sizes (storage.rules makes
    // sure the uploads aren't bigger), and withdrawing or deleting one lowers it.
    // (No ternaries and no out-of-range indexing below: every list access is
    // guarded by a short-circuiting && or ||.)
    function quotaBytes() {
      return 1073741824;
    }
    // Every declared size is a whole number of bytes, at most 25 MB.
    function filesOk(a) {
      return a.size() >= 1 && a.size() <= 20
        && (a.size() <= 0 || (a[0]['size'] is int && a[0]['size'] >= 0 && a[0]['size'] <= 26215424))
        && (a.size() <= 1 || (a[1]['size'] is int && a[1]['size'] >= 0 && a[1]['size'] <= 26215424))
        && (a.size() <= 2 || (a[2]['size'] is int && a[2]['size'] >= 0 && a[2]['size'] <= 26215424))
        && (a.size() <= 3 || (a[3]['size'] is int && a[3]['size'] >= 0 && a[3]['size'] <= 26215424))
        && (a.size() <= 4 || (a[4]['size'] is int && a[4]['size'] >= 0 && a[4]['size'] <= 26215424))
        && (a.size() <= 5 || (a[5]['size'] is int && a[5]['size'] >= 0 && a[5]['size'] <= 26215424))
        && (a.size() <= 6 || (a[6]['size'] is int && a[6]['size'] >= 0 && a[6]['size'] <= 26215424))
        && (a.size() <= 7 || (a[7]['size'] is int && a[7]['size'] >= 0 && a[7]['size'] <= 26215424))
        && (a.size() <= 8 || (a[8]['size'] is int && a[8]['size'] >= 0 && a[8]['size'] <= 26215424))
        && (a.size() <= 9 || (a[9]['size'] is int && a[9]['size'] >= 0 && a[9]['size'] <= 26215424))
        && (a.size() <= 10 || (a[10]['size'] is int && a[10]['size'] >= 0 && a[10]['size'] <= 26215424))
        && (a.size() <= 11 || (a[11]['size'] is int && a[11]['size'] >= 0 && a[11]['size'] <= 26215424))
        && (a.size() <= 12 || (a[12]['size'] is int && a[12]['size'] >= 0 && a[12]['size'] <= 26215424))
        && (a.size() <= 13 || (a[13]['size'] is int && a[13]['size'] >= 0 && a[13]['size'] <= 26215424))
        && (a.size() <= 14 || (a[14]['size'] is int && a[14]['size'] >= 0 && a[14]['size'] <= 26215424))
        && (a.size() <= 15 || (a[15]['size'] is int && a[15]['size'] >= 0 && a[15]['size'] <= 26215424))
        && (a.size() <= 16 || (a[16]['size'] is int && a[16]['size'] >= 0 && a[16]['size'] <= 26215424))
        && (a.size() <= 17 || (a[17]['size'] is int && a[17]['size'] >= 0 && a[17]['size'] <= 26215424))
        && (a.size() <= 18 || (a[18]['size'] is int && a[18]['size'] >= 0 && a[18]['size'] <= 26215424))
        && (a.size() <= 19 || (a[19]['size'] is int && a[19]['size'] >= 0 && a[19]['size'] <= 26215424));
    }
    // The declared sizes add up to exactly t (rules have no loops).
    function sumIs(a, t) {
      return (a.size() == 1 && t == a[0]['size'])
        || (a.size() == 2 && t == a[0]['size'] + a[1]['size'])
        || (a.size() == 3 && t == a[0]['size'] + a[1]['size'] + a[2]['size'])
        || (a.size() == 4 && t == a[0]['size'] + a[1]['size'] + a[2]['size'] + a[3]['size'])
        || (a.size() == 5 && t == a[0]['size'] + a[1]['size'] + a[2]['size'] + a[3]['size'] + a[4]['size'])
        || (a.size() == 6 && t == a[0]['size'] + a[1]['size'] + a[2]['size'] + a[3]['size'] + a[4]['size'] + a[5]['size'])
        || (a.size() == 7 && t == a[0]['size'] + a[1]['size'] + a[2]['size'] + a[3]['size'] + a[4]['size'] + a[5]['size'] + a[6]['size'])
        || (a.size() == 8 && t == a[0]['size'] + a[1]['size'] + a[2]['size'] + a[3]['size'] + a[4]['size'] + a[5]['size'] + a[6]['size'] + a[7]['size'])
        || (a.size() == 9 && t == a[0]['size'] + a[1]['size'] + a[2]['size'] + a[3]['size'] + a[4]['size'] + a[5]['size'] + a[6]['size'] + a[7]['size'] + a[8]['size'])
        || (a.size() == 10 && t == a[0]['size'] + a[1]['size'] + a[2]['size'] + a[3]['size'] + a[4]['size'] + a[5]['size'] + a[6]['size'] + a[7]['size'] + a[8]['size'] + a[9]['size'])
        || (a.size() == 11 && t == a[0]['size'] + a[1]['size'] + a[2]['size'] + a[3]['size'] + a[4]['size'] + a[5]['size'] + a[6]['size'] + a[7]['size'] + a[8]['size'] + a[9]['size'] + a[10]['size'])
        || (a.size() == 12 && t == a[0]['size'] + a[1]['size'] + a[2]['size'] + a[3]['size'] + a[4]['size'] + a[5]['size'] + a[6]['size'] + a[7]['size'] + a[8]['size'] + a[9]['size'] + a[10]['size'] + a[11]['size'])
        || (a.size() == 13 && t == a[0]['size'] + a[1]['size'] + a[2]['size'] + a[3]['size'] + a[4]['size'] + a[5]['size'] + a[6]['size'] + a[7]['size'] + a[8]['size'] + a[9]['size'] + a[10]['size'] + a[11]['size'] + a[12]['size'])
        || (a.size() == 14 && t == a[0]['size'] + a[1]['size'] + a[2]['size'] + a[3]['size'] + a[4]['size'] + a[5]['size'] + a[6]['size'] + a[7]['size'] + a[8]['size'] + a[9]['size'] + a[10]['size'] + a[11]['size'] + a[12]['size'] + a[13]['size'])
        || (a.size() == 15 && t == a[0]['size'] + a[1]['size'] + a[2]['size'] + a[3]['size'] + a[4]['size'] + a[5]['size'] + a[6]['size'] + a[7]['size'] + a[8]['size'] + a[9]['size'] + a[10]['size'] + a[11]['size'] + a[12]['size'] + a[13]['size'] + a[14]['size'])
        || (a.size() == 16 && t == a[0]['size'] + a[1]['size'] + a[2]['size'] + a[3]['size'] + a[4]['size'] + a[5]['size'] + a[6]['size'] + a[7]['size'] + a[8]['size'] + a[9]['size'] + a[10]['size'] + a[11]['size'] + a[12]['size'] + a[13]['size'] + a[14]['size'] + a[15]['size'])
        || (a.size() == 17 && t == a[0]['size'] + a[1]['size'] + a[2]['size'] + a[3]['size'] + a[4]['size'] + a[5]['size'] + a[6]['size'] + a[7]['size'] + a[8]['size'] + a[9]['size'] + a[10]['size'] + a[11]['size'] + a[12]['size'] + a[13]['size'] + a[14]['size'] + a[15]['size'] + a[16]['size'])
        || (a.size() == 18 && t == a[0]['size'] + a[1]['size'] + a[2]['size'] + a[3]['size'] + a[4]['size'] + a[5]['size'] + a[6]['size'] + a[7]['size'] + a[8]['size'] + a[9]['size'] + a[10]['size'] + a[11]['size'] + a[12]['size'] + a[13]['size'] + a[14]['size'] + a[15]['size'] + a[16]['size'] + a[17]['size'])
        || (a.size() == 19 && t == a[0]['size'] + a[1]['size'] + a[2]['size'] + a[3]['size'] + a[4]['size'] + a[5]['size'] + a[6]['size'] + a[7]['size'] + a[8]['size'] + a[9]['size'] + a[10]['size'] + a[11]['size'] + a[12]['size'] + a[13]['size'] + a[14]['size'] + a[15]['size'] + a[16]['size'] + a[17]['size'] + a[18]['size'])
        || (a.size() == 20 && t == a[0]['size'] + a[1]['size'] + a[2]['size'] + a[3]['size'] + a[4]['size'] + a[5]['size'] + a[6]['size'] + a[7]['size'] + a[8]['size'] + a[9]['size'] + a[10]['size'] + a[11]['size'] + a[12]['size'] + a[13]['size'] + a[14]['size'] + a[15]['size'] + a[16]['size'] + a[17]['size'] + a[18]['size'] + a[19]['size']);
    }
    function usagePath(uid) {
      return /databases/$(database)/documents/usage/$(uid);
    }
    // A new message's files raise the sender's total by exactly their sizes,
    // staying within the allowance.
    function countedOk(uid, a) {
      let p = usagePath(uid);
      let after = getAfter(p).data.bytes;
      return filesOk(a)
        && after is int
        && after <= quotaBytes()
        && ((!exists(p) && sumIs(a, after))
            || (exists(p) && sumIs(a, after - get(p).data.bytes)));
    }

    // Lowering a sender's total: only together with withdrawing or deleting
    // one of their counted messages (named in `freed`), by exactly its files.
    function freedOk(uid) {
      let m = request.resource.data.get('freed', '');
      let p = usagePath(uid);
      let path = /databases/$(database)/documents/messages/$(m);
      return m is string && m != ''
        && exists(p)
        && exists(path)
        && get(path).data.senderUid == uid
        && get(path).data.withdrawn == false
        && get(path).data.get('counted', false) == true
        && (!existsAfter(path) || getAfter(path).data.withdrawn == true)
        && sumIs(get(path).data.attachments, get(p).data.bytes - request.resource.data.bytes);
    }

    // ---- Old ChiaraMail (Android app, 2020): device registrations. ----------
    // Kept exactly as it was in project chiaramail-15119 so the old app keeps
    // working. NOTE: this lets anyone read or write users/ — see README.
    match /users/{docId} {
			allow read,write: if true;
//      allow write: if request.resource.data.DeviceID == docId;
//      allow create: if request.resource.data.DeviceID == docId;
 //   	allow update: if resource.data.DeviceID == docId;
    }

    // ---- ChiaraMail web ------------------------------------------------------

    // The ECS directory: addresses that have signed in to ChiaraMail, so mail
    // from them can be marked as coming from an ECS user. One address can be
    // looked up at a time; the list can't be browsed.
    match /ecsUsers/{email} {
      allow get: if signedIn();
      allow create: if verified()
        && email == myEmail()
        && request.resource.data.keys().hasOnly(['since'])
        && request.resource.data.since == request.time;
      allow delete: if verified() && email == myEmail();
    }

    // A sender's attachment total. They can read it; raising it is always
    // allowed (it only limits them), lowering it only together with withdrawing
    // or deleting one of their counted messages, by exactly its files' sizes.
    // A user's own settings: only their email signature, readable and writable by them alone.
    match /prefs/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['signature', 'updatedAt'])
        && request.resource.data.signature is string
        && request.resource.data.signature.size() <= 10000
        && request.resource.data.updatedAt == request.time;
    }

    match /usage/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['bytes', 'freed'])
        && request.resource.data.bytes is int
        && request.resource.data.bytes >= 0
        && (!exists(usagePath(uid))
            || request.resource.data.bytes >= get(usagePath(uid)).data.bytes
            || freedOk(uid));
    }

    match /messages/{id} {
      allow read: if isSender(resource.data) || isRecipient(resource.data);

      allow create: if verified()
        && request.resource.data.keys().hasOnly(
             ['senderUid', 'senderEmail', 'senderName', 'recipients', 'subject',
              'body', 'createdAt', 'updatedAt', 'edition', 'withdrawn', 'allowForward',
              'attachments', 'enc', 'counted'])
        && request.resource.data.keys().hasAll(
             ['senderUid', 'senderEmail', 'recipients', 'subject', 'body',
              'createdAt', 'updatedAt', 'edition', 'withdrawn'])
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderEmail == myEmail()
        && (!('allowForward' in request.resource.data)
            || request.resource.data.allowForward is bool)
        // enc: 1 when the content is end-to-end encrypted (subject, body and
        // attachment names are then ciphertext, readable only with the key
        // that travels in the email). ChiaraMail itself can't read them.
        && (!('enc' in request.resource.data) || request.resource.data.enc == 1)
        // Names, types and sizes of the files stored with it (see storage.rules).
        && (!('attachments' in request.resource.data)
            || (request.resource.data.attachments is list
                && request.resource.data.attachments.size() >= 1
                && request.resource.data.attachments.size() <= 20
                // counted against the sender's allowance, in the same batch
                && request.resource.data.get('counted', false) == true
                && countedOk(request.auth.uid, request.resource.data.attachments)))
        && (!('counted' in request.resource.data) || 'attachments' in request.resource.data)
        && (!('senderName' in request.resource.data)
            || (request.resource.data.senderName is string
                && request.resource.data.senderName.size() <= 120))
        && request.resource.data.recipients is list
        && request.resource.data.recipients.size() >= 1
        && request.resource.data.recipients.size() <= 50
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 2000
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 300000
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.edition == 1
        && request.resource.data.withdrawn == false;

      // The sender may rewrite the subject and text (a new edition), or
      // withdraw the message, which wipes its text for good. Recipients and
      // authorship never change after sending. Separately, the sender may
      // switch forwarding on or off without making a new edition.
      allow update: if isSender(resource.data)
        && resource.data.withdrawn == false
        && (
             (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['allowForward'])
               && request.resource.data.allowForward is bool)
          || (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['subject', 'body', 'updatedAt', 'edition', 'withdrawn'])
               && request.resource.data.updatedAt == request.time
               && request.resource.data.subject is string
               && request.resource.data.subject.size() <= 2000
               && request.resource.data.body is string
               && request.resource.data.body.size() <= 300000
               && (
                    (request.resource.data.withdrawn == false
                      && request.resource.data.body.size() >= 1
                      && request.resource.data.edition == resource.data.edition + 1)
                 || (request.resource.data.withdrawn == true
                      && request.resource.data.body == ''
                      && request.resource.data.edition == resource.data.edition)
               ))
        );

      allow delete: if isSender(resource.data);

      // Every edition the sender saves is kept, for the sender's eyes only.
      match /editions/{editionId} {
        allow read: if isSender(msg(id));
        allow create: if isSender(msgAfter(id))
          && request.resource.data.keys().hasOnly(['edition', 'subject', 'body', 'savedAt'])
          && request.resource.data.edition == msgAfter(id).edition
          && editionId == string(msgAfter(id).edition)
          && request.resource.data.subject is string
          && request.resource.data.body is string
          && request.resource.data.savedAt == request.time;
        allow delete: if isSender(msg(id));
      }

      // Read receipts: each recipient records when they last opened the
      // message and which edition they saw. The reader is told about this.
      match /reads/{email} {
        allow read: if isSender(msg(id))
          || (verified() && email == myEmail());
        allow create, update: if isRecipient(msg(id))
          && email == myEmail()
          && request.resource.data.keys().hasOnly(['lastReadAt', 'editionSeen'])
          && request.resource.data.lastReadAt == request.time
          && request.resource.data.editionSeen is int;
        allow delete: if isSender(msg(id));
      }
    }
  }
}
