# Copy to .env.local and fill in.
# Firebase console → Project settings → General → Your apps → chiaramail-web.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=chiaramail-15119.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=chiaramail-15119
VITE_FIREBASE_APP_ID=

# Google Cloud console → APIs & Services → Credentials → OAuth 2.0 Client IDs →
# "Web client (auto created by Google Service)" → Client ID.
VITE_GOOGLE_CLIENT_ID=

# The address that links to changeable messages should use.
VITE_PUBLIC_ORIGIN=https://app.chiaramail.com
